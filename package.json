{
  "name": "md-reader",
  "version": "1.0.0",
  "description": "A clean macOS markdown reader & editor",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/scripts/preview.js src/renderer/scripts/editor.js --bundle --minify --format=iife --outdir=src/renderer/dist --log-level=warning",
    "start": "npm run build:renderer && electron .",
    "test": "node tests/verify-preview.js && node tests/verify-sidebar.js",
    "build": "npm run build:renderer && electron-builder --mac",
    "pack": "npm run build:renderer && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "build": {
    "appId": "com.mdreader.app",
    "productName": "MD reader",
    "icon": "build/icon.icns",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "dir"
      ],
      "darkModeSupport": true
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/preload.js",
      "src/renderer/styles/**/*",
      "src/renderer/dist/**/*",
      "src/renderer/scripts/i18n.js",
      "src/renderer/scripts/theme.js",
      "src/renderer/scripts/app.js"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}
